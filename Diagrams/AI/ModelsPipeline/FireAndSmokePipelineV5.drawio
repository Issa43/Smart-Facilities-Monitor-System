<mxfile host="app.diagrams.net"><diagram id="pipeline" name="Fire and Smoke Pipeline"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="3880" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_pre" value="YOLO26 Detection Module: Frame Preprocessing" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;strokeColor=none;fillColor=none;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="262" y="748" width="450" height="26" as="geometry"/></mxCell><mxCell id="f_pre" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="260" y="775" width="520" height="290" as="geometry"/></mxCell><mxCell id="t_inf" value="YOLO26 Inference" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;strokeColor=none;fillColor=none;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="262" y="1078" width="250" height="26" as="geometry"/></mxCell><mxCell id="f_inf" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="260" y="1105" width="520" height="110" as="geometry"/></mxCell><mxCell id="t_post" value="Post-Processing" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;strokeColor=none;fillColor=none;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="262" y="1228" width="250" height="26" as="geometry"/></mxCell><mxCell id="f_post" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="260" y="1255" width="520" height="195" as="geometry"/></mxCell><mxCell id="t_core" value="Core Logic" style="text;html=1;align=left;verticalAlign=middle;fontStyle=1;strokeColor=none;fillColor=none;fontFamily=Times New Roman;fontSize=14;" vertex="1" parent="1"><mxGeometry x="200" y="1577" width="300" height="26" as="geometry"/></mxCell><mxCell id="f_core" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="200" y="1605" width="760" height="1845" as="geometry"/></mxCell><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="490" y="20" width="60" height="60" as="geometry"/></mxCell><mxCell id="open" value="Open Video Source&lt;br&gt;(RTSP / File)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410.0" y="110" width="220" height="60" as="geometry"/></mxCell><mxCell id="note" value="Configuration&lt;br&gt;&lt;br&gt;FRAME_SKIP = 5&lt;br&gt;IMAGE_SIZE = 640&lt;br&gt;CONF_THRESHOLD = 0.378&lt;br&gt;WINDOW_SIZE = 6&lt;br&gt;WINDOW_MAX_AGE = 10 s&lt;br&gt;FIRE_ALERT_FRAMES = 4&lt;br&gt;SMOKE_ALERT_FRAMES = 3&lt;br&gt;REMINDER_INTERVAL = 5 min&lt;br&gt;INCIDENT_CLEAR_TIME = 30 s&lt;br&gt;SETTINGS_REFRESH = 30 s" style="shape=note;whiteSpace=wrap;html=1;size=18;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontStyle=1;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="680" y="10" width="230" height="205" as="geometry"/></mxCell><mxCell id="read" value="Read The Frame&lt;br&gt;OpenCV BGR Matrix" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410.0" y="220" width="220" height="60" as="geometry"/></mxCell><mxCell id="d_read" value="Frame read&lt;br&gt;successfully?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420.0" y="320" width="200" height="110" as="geometry"/></mxCell><mxCell id="d_loop" value="Loop video&lt;br&gt;enabled?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="15.0" y="320" width="170" height="110" as="geometry"/></mxCell><mxCell id="reopen" value="Release source, wait 2 s&lt;br&gt;and reopen it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="15.0" y="220" width="170" height="60" as="geometry"/></mxCell><mxCell id="count" value="Frame Count + 1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410.0" y="480" width="220" height="60" as="geometry"/></mxCell><mxCell id="d_skip" value="Frame Count % 5 == 0&lt;br&gt;and model enabled&lt;br&gt;for this camera?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395.0" y="580" width="250" height="130" as="geometry"/></mxCell><mxCell id="pub_last" value="Publish frame to live stream&lt;br&gt;(last known boxes, or the&lt;br&gt;'model disabled' label)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="945.0" y="610" width="190" height="70" as="geometry"/></mxCell><mxCell id="resize" value="Resize and pad frame&lt;br&gt;to IMAGE_SIZE (640)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390.0" y="795" width="260" height="60" as="geometry"/></mxCell><mxCell id="convert" value="Convert Color Channels (BGR To RGB)&lt;br&gt;and Permute Dims (HWC To NCHW)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390.0" y="885" width="260" height="60" as="geometry"/></mxCell><mxCell id="tensor" value="Convert to PyTorch tensor&lt;br&gt;and normalize pixels (/255.0, float32)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="390.0" y="975" width="260" height="60" as="geometry"/></mxCell><mxCell id="infer" value="Execute YOLO Forward Pass&lt;br&gt;on GPU/CPU" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410.0" y="1130" width="220" height="60" as="geometry"/></mxCell><mxCell id="filter" value="Filter Detections by&lt;br&gt;CONF_THRESHOLD (0.378)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410.0" y="1275" width="220" height="60" as="geometry"/></mxCell><mxCell id="nms" value="Apply Non-Maximum&lt;br&gt;Suppression (NMS)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410.0" y="1365" width="220" height="60" as="geometry"/></mxCell><mxCell id="pub_ann" value="Publish annotated frame&lt;br&gt;to live stream" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410.0" y="1490" width="220" height="60" as="geometry"/></mxCell><mxCell id="group" value="Group detections by class&lt;br&gt;(frame + boxes as evidence)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410.0" y="1630" width="220" height="60" as="geometry"/></mxCell><mxCell id="d_classes" value="Are there&lt;br&gt;unprocessed classes&lt;br&gt;(Fire, Smoke)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="405.0" y="1730" width="230" height="120" as="geometry"/></mxCell><mxCell id="d_det" value="Class detected&lt;br&gt;in this frame?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420.0" y="1900" width="200" height="100" as="geometry"/></mxCell><mxCell id="add1" value="Add 1 and the evidence&lt;br&gt;to the class window (size 6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="250.0" y="1990" width="190" height="60" as="geometry"/></mxCell><mxCell id="add0" value="Add 0 to the class&lt;br&gt;window (size 6)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="600.0" y="1990" width="190" height="60" as="geometry"/></mxCell><mxCell id="prune" value="Remove checks older than&lt;br&gt;10 s from the window" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410.0" y="2100" width="220" height="60" as="geometry"/></mxCell><mxCell id="d_clear" value="Incident open and&lt;br&gt;class undetected&lt;br&gt;for 30 s?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="400.0" y="2200" width="240" height="120" as="geometry"/></mxCell><mxCell id="close" value="Close the incident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="710.0" y="2230" width="160" height="60" as="geometry"/></mxCell><mxCell id="d_full" value="Is the window&lt;br&gt;full?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420.0" y="2370" width="200" height="110" as="geometry"/></mxCell><mxCell id="d_thr" value="Sum of the window&lt;br&gt;meets the threshold?&lt;br&gt;(Fire &amp;gt;= 4, Smoke &amp;gt;= 3)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="395.0" y="2530" width="250" height="130" as="geometry"/></mxCell><mxCell id="d_inc" value="Is an incident&lt;br&gt;open?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="420.0" y="2710" width="200" height="110" as="geometry"/></mxCell><mxCell id="open_inc" value="Open a new incident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="705.0" y="2735" width="170" height="60" as="geometry"/></mxCell><mxCell id="d_rem" value="5 min since&lt;br&gt;the last alarm?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="405.0" y="2870" width="230" height="120" as="geometry"/></mxCell><mxCell id="mark" value="Mark the alarm&lt;br&gt;as a reminder" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="410.0" y="3040" width="220" height="60" as="geometry"/></mxCell><mxCell id="pick" value="Pick the highest-confidence frame&lt;br&gt;in the window and draw all its boxes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380.0" y="3140" width="280" height="60" as="geometry"/></mxCell><mxCe