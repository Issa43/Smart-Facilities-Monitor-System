<mxfile host="app.diagrams.net"><diagram id="incident" name="Incident States"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1150" pageHeight="570" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="45" y="215" width="30" height="30" as="geometry"/></mxCell><mxCell id="idle" value="No Incident" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="150" y="160" width="200" height="140" as="geometry"/></mxCell><mxCell id="open" value="Incident Open" style="rounded=1;arcSize=20;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=15;fontFamily=Times New Roman;" vertex="1" parent="1"><mxGeometry x="650" y="160" width="200" height="140" as="geometry"/></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontStyle=1;fontFamily=Times New Roman;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="idle"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="[window full and sum &amp;gt;= threshold]&lt;br&gt;/ raise alarm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontStyle=1;fontFamily=Times New Roman;fontSize=12;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="idle" target="open"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="[class undetected for 30 s]&lt;br&gt;/ close incident" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontStyle=1;fontFamily=Times New Roman;fontSize=12;labelBackgroundColor=#ffffff;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="open" target="idle"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="[class detected]&lt;br&gt;/ update last detection time" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontStyle=1;fontFamily=Times New Roman;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.3;exitY=0;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="open" target="open"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="710" y="90"/><mxPoint x="790" y="90"/></Array></mxGeometry></mxCell><mxCell id="e7" value="[still confirmed and 5 min&lt;br&gt;since the last alarm]&lt;br&gt;/ send reminder" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;endArrow=classic;endFill=1;strokeColor=#000000;fontStyle=1;fontFamily=Times New Roman;fontSize=12;labelBackgroundColor=#ffffff;exitX=0.7;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="open" target="open"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="790" y="370"/><mxPoint x="710" y="370"/></Array></mxGeometry></mxCell><mxCell id="note" value="Fire and Smoke each run their own copy of this state machine.&lt;br&gt;On every check, in both states: add 1 or 0 to the class window (size 6)&lt;br&gt;and remove checks older than 10 s.&lt;br&gt;Thresholds: Fire &amp;gt;= 4 of 6, Smoke &amp;gt;= 3 of 6." style="shape=note;whiteSpace=wrap;html=1;size=15;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;fontFamily=Times New Roman;fontSize=13;" vertex="1" parent="1"><mxGeometry x="150" y="450" width="700" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>