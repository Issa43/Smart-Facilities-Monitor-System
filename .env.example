# Django
DJANGO_SETTINGS_MODULE=config.settings.development
SECRET_KEY=change-me-in-production-use-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# PostgreSQL
DB_NAME=sflms_db
DB_USER=sflms_user
DB_PASSWORD=change-me
DB_HOST=postgres
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_SSL_REQUIRE=False
# Optional: when set, DATABASE_URL overrides the individual DB_* variables.
DATABASE_URL=
# Example: postgresql://sflms_user:change-me@postgres:5432/sflms_db

# CORS - the separate HTML/CSS/JS frontend origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5500,http://127.0.0.1:5500

# JWT
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Redis: separate logical databases for Celery, cache, and Channels.
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1
CHANNEL_REDIS_URL=redis://redis:6379/2
CACHE_DEFAULT_TIMEOUT=300
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Firebase Cloud Messaging (server-side only). Mount the service-account JSON
# outside source control and set its in-container path here.
FCM_ENABLED=False
FCM_PROJECT_ID=
FCM_CREDENTIALS_PATH=/run/secrets/firebase-service-account.json

# External safety alerts (disabled by default). Alert creation also requires
# the safety.externalAlerts system setting to be enabled by a Super Admin.
SAFETY_ALERTS_ENABLED=False
# Hazard provider polling (Celery Beat). Polls exit before any network call
# while alerting is disabled. URLs must stay on the approved provider hosts.
SAFETY_USGS_ENABLED=True
SAFETY_USGS_FEED_URL=https://earthquake.usgs.gov/earthquakes/feed/v1.0/summary/2.5_day.geojson
SAFETY_USGS_POLL_SECONDS=300
SAFETY_GDACS_ENABLED=True
SAFETY_GDACS_EVENTS_URL=https://www.gdacs.org/gdacsapi/api/events/geteventlist/EVENTS4APP
SAFETY_GDACS_POLL_SECONDS=900
SAFETY_PROVIDER_TIMEOUT_SECONDS=10
SAFETY_PROVIDER_MAX_BYTES=5242880
SAFETY_PROVIDER_MAX_RETRIES=2
# Official Syrian MHEWS weather warnings (CAP 1.2, public, no credentials).
# Disabled by default and additionally gated by both Safety kill switches.
# The feed URL is fixed in code and intentionally not configurable.
SAFETY_WEATHER_ENABLED=False
SAFETY_MHEWS_POLL_SECONDS=900
# Outbound-only Telegram delivery of recorded safety decisions (disabled by
# default). While disabled, nothing is queued and no request is made. Set the
# bot token in the deployment environment only; never commit a real value.
SAFETY_TELEGRAM_ENABLED=False
# Bot token from BotFather. Secret: never commit a real value, and never
# expose it to the frontend. Each project's destination chat id is stored
# server-side in Django Admin (Safety -> Project telegram destinations),
# not here and not in code.
SAFETY_TELEGRAM_BOT_TOKEN=
SAFETY_TELEGRAM_TIMEOUT_SECONDS=10
SAFETY_TELEGRAM_MAX_RETRIES=3
SAFETY_TELEGRAM_MAX_MESSAGE_CHARS=3500

# Container startup
WAIT_FOR_SERVICES=1
SERVICE_WAIT_TIMEOUT=60
SERVICE_WAIT_INTERVAL=2
RUN_MIGRATIONS=0
COLLECT_STATIC=0

# Logging
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO
LOG_FORMAT=json

# Development host-port overrides
BACKEND_PORT=8000
POSTGRES_PORT_FORWARD=5432
REDIS_PORT_FORWARD=6379

# Production hardening (used by config.settings.production)
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
USE_X_FORWARDED_PROTO=True
# Transactional email / password reset.
# These values are for a real deployment. Local development does not need them:
# docker-compose.override.yml points the dev containers at the Mailpit service
# (EMAIL_HOST=mailpit, port 1025, no TLS, no credentials) and the captured mail
# is read at http://localhost:8025 — nothing is delivered off the machine.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@example.com
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password?uid={uid}&token={token}
PASSWORD_RESET_TIMEOUT_SECONDS=1800
API_ANON_RATE=60/minute
API_USER_RATE=600/minute
AI_INGESTION_RATE=1200/minute
PASSWORD_RESET_RATE=5/minute
DATA_UPLOAD_MAX_MEMORY_SIZE=31457280
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
