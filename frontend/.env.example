VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_DEMO_DATA=false
# Live MJPEG feed published by the fire/smoke detector (run_webcam.sh).
# Browser-side URL, so it points at the host, not a container name.
VITE_CAMERA_STREAM_URL=http://localhost:8090/stream
# Live MJPEG feed published by the intrusion detector. Separate container,
# separate port.
VITE_INTRUSION_STREAM_URL=http://localhost:8091/stream
